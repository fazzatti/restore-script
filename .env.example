# Stellar Network Configuration
NETWORK=testnet  # testnet | mainnet | futurenet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Account Configuration
STELLAR_SECRET_KEY=your_secret_key_here


BASE_FEE=10000 # Base fee for transactions
TTL_THRESHOLD=2073600 # how many ledgers from now the entry's liveUntilLedgerSeq should be to not need a bump
EXTEND_TTL_BY=2073600  # The number of ledgers to extend TTL by


# TTL_THRESHOLD=259200 # 15 days from now
# EXTEND_TTL_BY=259200 # 15 days from now

# TTL_THRESHOLD=777600 # 45 days from now
# EXTEND_TTL_BY=777600 # 45 days from now

# Contract for which the entries will be loaded and verified
CONTRACT_ID=
